# microCMS（サーバー専用。クライアントに露出させない）
# サービスID: 管理画面URL https://xxxxxxxx.microcms.io の xxxxxxxx 部分
MICROCMS_SERVICE_DOMAIN=your-service-id
MICROCMS_API_KEY=your-api-key
# ニュースAPIのエンドポイントID（管理画面の API 設定で確認。例: news）
MICROCMS_NEWS_ENDPOINT=news

# Google Analytics 4（公開してよい計測ID）
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# サイト表示用（任意）
# Google マップ「共有」→「地図を埋め込む」の src URL（未設定時は代表地点の簡易埋め込み）
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
