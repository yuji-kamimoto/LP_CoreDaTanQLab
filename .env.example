# Instagram Graph API（サーバー専用。クライアントに露出させない）
# Instagram のプロアカウント（ビジネス/クリエイター）で発行した長期アクセストークン
# 取得手順: https://developers.facebook.com/docs/instagram-platform
# 長期トークンは 60 日間有効。必要に応じて `ig_refresh_token` で更新する運用を行う
INSTAGRAM_ACCESS_TOKEN=

# Google Analytics 4（公開してよい計測ID）
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# サイト表示用（任意）
# Google マップ「共有」→「地図を埋め込む」の src URL（未設定時は代表地点の簡易埋め込み）
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# お問い合わせフォーム（Xserver SMTP 直接送信）。未設定時は送信APIが 503 になる
# Xserver のメール設定（サーバーパネル →「メールアカウント設定」→「メールソフト設定」）参照
# SMTP ホスト（例: svXXXX.xserver.jp。サーバーごとに異なる）
SMTP_HOST=
# ポート（SSL/TLS は 465、STARTTLS は 587）
SMTP_PORT=465
# 送信に使うメールアカウント（推奨: 送信専用アカウント）
SMTP_USER=
# 上記アカウントのパスワード
SMTP_PASS=
# 送信元アドレス（未設定時は SMTP_USER と同じ）
CONTACT_FROM_EMAIL=
# 問い合わせの受信先メール
CONTACT_TO_EMAIL=
