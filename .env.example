# Instagram Graph API（サーバー専用。クライアントに露出させない）
# Instagram のプロアカウント（ビジネス/クリエイター）で発行した長期アクセストークン
# 取得手順: https://developers.facebook.com/docs/instagram-platform
# 長期トークンは 60 日間有効。必要に応じて `ig_refresh_token` で更新する運用を行う
INSTAGRAM_ACCESS_TOKEN=

# Google Analytics 4（公開してよい計測ID）
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# サイト表示用（任意）
# Google マップ「共有」→「地図を埋め込む」の src URL（未設定時は代表地点の簡易埋め込み）
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_LINE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# お問い合わせフォーム（Resend）。未設定時は送信APIが 503 になり、フォーム下に案内を表示
# https://resend.com で API キー取得。送信元は検証済みドメインのメールに差し替え推奨
RESEND_API_KEY=
# 受信メール（未設定時は site-config の contact.email）
CONTACT_TO_EMAIL=
# 送信元（例: CoreDa! 探究ラボ <mail@yourdomain.com>）。未設定時は Resend の onboarding@resend.dev
RESEND_FROM_EMAIL=
